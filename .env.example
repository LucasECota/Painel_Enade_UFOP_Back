# Chave secreta da anonimização (HMAC). Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANONIMIZACAO_SEGREDO=troque-por-uma-chave-longa-e-aleatoria

# (opcional) endereços do site autorizados a ler a API pelo navegador, separados por vírgula.
# Sem isso, só o front de desenvolvimento (http://localhost:5173) é liberado.
#   CORS_ORIGINS=https://painel.exemplo.edu.br
# (opcional) limites de requisições por minuto, por IP:
#   LIMITE_REQUISICOES=120
#   LIMITE_DOWNLOADS=20

# Em produção, atrás de um servidor web (Nginx): veja o DEPLOY.md.
#   NODE_ENV=production
#   PORT=3000
#   HOST=127.0.0.1      # a API só aceita conexões locais; o público entra pelo Nginx
#   TRUST_PROXY=1       # quantos proxies há na frente da API (1 = o Nginx)
